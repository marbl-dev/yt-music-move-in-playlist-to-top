{
  "manifest_version": 3,
  "name": "YT Music: Move to Top",
  "version": "0.1.0",
  "description": "Adds a \"Move to top\" action to your YouTube Music playlists, for single songs and multi-selections.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["src/api.js", "src/content.js"],
      "css": ["src/styles.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
